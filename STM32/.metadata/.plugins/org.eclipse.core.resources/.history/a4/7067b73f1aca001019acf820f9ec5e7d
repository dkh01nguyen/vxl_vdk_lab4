#include "scheduler.h"

static Task* head = NULL;
static uint8_t taskID = 0;
static uint64_t tick = 0;


void SCH_Init(){
	head = NULL;
	taskID = 0;
	tick = 0;
}

void SCH_Update(){
	tick++;

	if (!(head == NULL)) {
		if (head->DELAY > 0) {
			head->DELAY--;
		}

		if (head->DELAY == 0) {
			head->RUN = 1;
		}
	}
}

uint32_t SCH_Add_Task(void (* pFunction)(), uint32_t DELAY, uint32_t PERIOD){

	Task* newTask = (Task* )malloc(sizeof(Task));

	newTask->pTask = pFunction;
	newTask->DELAY = DELAY;
	newTask->PERIOD = PERIOD;
	newTask->RUN = 0;
	newTask->TaskID = ++taskID;
	newTask->next = NULL;

	Task* tmp = head;
	Task* prev = NULL;
	uint64_t totalDelay = 0;

	//task is added and sorted based on delay
	while (tmp != NULL && totalDelay + tmp->DELAY < DELAY) {
		totalDelay += tmp->DELAY;
		prev = tmp;
		tmp = tmp->next;
	}

	newTask->DELAY = DELAY - totalDelay;
	if (tmp != NULL) {
		tmp->DELAY -= newTask->DELAY;
	}

	newTask->next = tmp;

	if (prev == NULL) { //the new task of the scheduler
		head = newTask;
	} else {
		prev->next = newTask; // n^th tasks of the scheduler
	}

	return newTask->taskID;
}

uint8_t SCH_Delete_Task(uint32_t taskID){
	Task *tmp = head;
	Task *prev = NULL;

	while (tmp != NULL) {
		if (tmp->taskID == taskID) {
			if (tmp->next != NULL) { // Add up the delay for the next task
				tmp->next->DELAY += tmp->DELAY;
			}

			if (prev == NULL) {
				head = tmp->next;
			} else {
				prev->next = tmp->next;
			}

			// Free memory
			free(tmp);

			return 1; // Success
		}
		prev = tmp;
		tmp = tmp->next;
	}

	return 0;
}

void SCH_Dispatch_Tasks(void){
	Task *tmp = head;
	Task *prev = NULL;

	while (tmp != NULL) {
		if (tmp->RUN > 0) {

			//Task is run then clear the flag
			(*tmp->pTask)();
			tmp->RUN = 0;

			//Two types of task: periodic and one-shot, handle one-shot first

			if (tmp->PERIOD == 0) {
				Task *deleteTask = tmp;
				if (prev == NULL) {
					head = tmp->next;
					tmp = head;
				} else {
					prev->next = tmp->next;
					tmp = prev->next;
				}

				free(deleteTask);
			} else { // Periodic handling
				tmp->DELAY = tmp->PERIOD;

				Task reinsertTask = tmp;
				if (prev == NULL) {
					head = tmp->next;
				} else {
					prev->next = tmp->next;
				}

				Task *insertTemp = head;
				Task *insertPrev = NULL;
				uint32_t totalDelay = 0;

				while (insertTemp != NULL && totalDelay + insertTemp->DELAY < reinsertTask->DELAY) {
					totalDelay += insertTemp->DELAY;
					insertPrev = insertTemp;
					insertTemp = insertTemp->next;
				}

				reinsertTask->DELAY -= totalDelay;
				if (insertTemp != NULL) {
					insertTemp->DELAY -= reinsertTask->DELAY;
				}

				reinsertTask->next = insertTemp;
				if (insertPrev == NULL) {
					head = reinsertTask;
				} else {
					insertPrev->next = reinsertTask;
				}

				tmp = (prev == NULL) ? head : prev->next;
			}
		} else {
			prev = tmp;
			tmp = tmp->next;
		}
	}
}
