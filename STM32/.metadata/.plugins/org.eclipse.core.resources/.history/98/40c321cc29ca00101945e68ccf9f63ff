#include "fsm_traffic_light.h"

int mode = INIT;
int status = INIT;

void fsm() {
	switch (mode) {
		case FMANUAL:
			if (isButtonPressed(0) == 1 || isButtonPressed(2) == 1 && status == FLASH_AMBER){
				mode = AUTO; // flash amber state
				status = MODE1;
			}

			if (isButtonPressed(2) == 1 && status == MANUAL) {  // Manual state - the first button is
				mode = AUTO; 									// useless at this point
				status = MODE1;
			}
			fsm_manual();
			break;
		default:
			break;
	}
}

