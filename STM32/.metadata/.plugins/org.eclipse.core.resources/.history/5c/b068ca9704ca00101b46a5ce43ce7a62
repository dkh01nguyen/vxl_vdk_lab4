#include "fsm_traffic_light.h"



void fsm_traffic_light(){

	//MODE2
	case MODE2:
		status = AUTO_RED;
		//Set up RED LED
		HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, RESET);
		HAL_GPIO_WritePin(A1_GPIO_Port, A1_Pin, SET);
		HAL_GPIO_WritePin(G1_GPIO_Port, G1_Pin, SET);
		HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, RESET);
		HAL_GPIO_WritePin(A2_GPIO_Port, A2_Pin, SET);
		HAL_GPIO_WritePin(G2_GPIO_Port, G2_Pin, SET);

		index_led = 0;
		updateLedBufferMode2();
		update7SEG(index_led);

		setTimer(2, 250);			// Set timer for 7SEG LED
		setTimer(3, 500);			// Set timer for blinking LED
		clearTimer(0);				// Clear timer display LED in MODE1
		clearTimer(1);				// Clear timer update buffer
		t = RED;
		break;

	case AUTO_RED:
		if (timer_flag[2] == 1){
			updateLedBufferMode2();
			update7SEG(index_led);
			setTimer(2, 250);
		}
		if (timer_flag[3] == 1){
			HAL_GPIO_TogglePin(R1_GPIO_Port, R1_Pin);
			HAL_GPIO_TogglePin(R2_GPIO_Port, R2_Pin);
			setTimer(3, 500);
		}
		if (isButtonPressed(0) == 1){
			RED = 5;
			status = MODE3;
		}

		if (isButtonPressed(1) == 1){
			if (t > 99) {
				t = 0;
				RED = 0;
			} else {
					t++;
					RED++;
				}
		}

		if (isButtonPressed(2) == 1){
			status = MODE3;
			RED = t;
		}
		break;

	//MODE3
	case MODE3:
		status = AUTO_AMBER;
		//Set up AMBER LED
		HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, SET);
		HAL_GPIO_WritePin(A1_GPIO_Port, A1_Pin, RESET);
		HAL_GPIO_WritePin(G1_GPIO_Port, G1_Pin, SET);
		HAL_GPIO_WritePin(R2_GPIO_Port, R2_Pin, SET);
		HAL_GPIO_WritePin(A2_GPIO_Port, A2_Pin, RESET);
		HAL_GPIO_WritePin(G2_GPIO_Port, G2_Pin, SET);

		index_led = 0;
		updateLedBufferMode3();
		update7SEG(index_led);

		setTimer(2, 250);			// Set timer for 7SEG LED
		setTimer(3, 500);			// Set timer for blinking LED
		clearTimer(0);				// Clear timer display LED in MODE1
		clearTimer(1);				// Clear timer update buffer
		t = AMBER;
		break;

	case AUTO_AMBER:
		if (timer_flag[2] == 1){
			updateLedBufferMode3();
			update7SEG(index_led);
			setTimer(2, 250);
		}
		if (timer_flag[3] == 1){
			HAL_GPIO_TogglePin(A1_GPIO_Port, A1_Pin);
			HAL_GPIO_TogglePin(A2_GPIO_Port, A2_Pin);
			setTimer(3, 500);
		}
		if (isButtonPressed(0) == 1){
			status = MODE4;
			AMBER = 2;
		}

		if (isButtonPressed(1) == 1){
			if (t > 99) {
				t = 0;
				AMBER = 0;
			} else {
				t++;
				AMBER++;
			}
		}

		if (isButtonPressed(2) == 1){
			status = MODE4;
			AMBER = t;
		}

		break;
	//MODE4
	case MODE4:
		status = AUTO_GREEN;
		//Set up GREEN LED
		HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, SET);
		HAL_GPIO_WritePin(A1_GPIO_Port, A1_Pin, SET);
		HAL_GPIO_WritePin(G1_GPIO_Port, G1_Pin, RESET);
		HAL_GPIO_WritePin(R2_GPIO_Port, R2_Pin, SET);
		HAL_GPIO_WritePin(A2_GPIO_Port, A2_Pin, SET);
		HAL_GPIO_WritePin(G2_GPIO_Port, G2_Pin, RESET);

		index_led = 0;
		updateLedBufferMode4();
		update7SEG(index_led);

		setTimer(2, 250);			// Set timer for 7SEG LED
		setTimer(3, 500);			// Set timer for blinking LED
		clearTimer(0);				// Clear timer display LED in MODE1
		clearTimer(1);				// Clear timer update buffer
		t = GREEN;
		break;

	case AUTO_GREEN:
		if (timer_flag[2] == 1){
			updateLedBufferMode4();
			update7SEG(index_led);
			setTimer(2, 250);
		}
		if (timer_flag[3] == 1){
			HAL_GPIO_TogglePin(G1_GPIO_Port, G1_Pin);
			HAL_GPIO_TogglePin(G2_GPIO_Port, G2_Pin);
			setTimer(3, 500);
		}
		if (isButtonPressed(0) == 1){
			status = MODE1;
			GREEN = 3;
		}

		if (isButtonPressed(1) == 1){
			if (t > 99) {
				t = 0;
				GREEN = 0;
			} else {
				t++;
				GREEN++;
			}
		}

		if (isButtonPressed(2) == 1){
			GREEN = t;
			update();
			status = MODE1;
		}
		break;
	case MODE5:
		HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, SET);
		HAL_GPIO_WritePin(A1_GPIO_Port, A1_Pin, RESET);
		HAL_GPIO_WritePin(G1_GPIO_Port, G1_Pin, SET);
		HAL_GPIO_WritePin(R2_GPIO_Port, R2_Pin, SET);
		HAL_GPIO_WritePin(A2_GPIO_Port, A2_Pin, RESET);
		HAL_GPIO_WritePin(G2_GPIO_Port, G2_Pin, SET);

		setTimer(3, 500);
		status = FLASH_AMBER;
	case FLASH_AMBER:
		clearLED();
		if (timer_flag[3] == 1){
			HAL_GPIO_TogglePin(A1_GPIO_Port, A1_Pin);
			HAL_GPIO_TogglePin(A2_GPIO_Port, A2_Pin);
			setTimer(3, 500);
		}
		if (isButtonPressed(0) == 1 || isButtonPressed(2) == 1){
			status = MODE1;
		}
		break;
	case MODE6:
		HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, RESET);
		HAL_GPIO_WritePin(A1_GPIO_Port, A1_Pin, SET);
		HAL_GPIO_WritePin(G1_GPIO_Port, G1_Pin, SET);
		HAL_GPIO_WritePin(R2_GPIO_Port, R2_Pin, SET);
		HAL_GPIO_WritePin(A2_GPIO_Port, A2_Pin, SET);
		HAL_GPIO_WritePin(G2_GPIO_Port, G2_Pin, RESET);
		clearLED();
		manual_state = RED_GREEN;
		status = MANUAL;
	case MANUAL:
		if (isButtonPressed(1) == 1){
			switch(manual_state){
				case RED_GREEN:
					manual_state = RED_AMBER;
					HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, SET);
					HAL_GPIO_WritePin(A1_GPIO_Port, A1_Pin, SET);
					HAL_GPIO_WritePin(G1_GPIO_Port, G1_Pin, RESET);
					HAL_GPIO_WritePin(R2_GPIO_Port, R2_Pin, SET);
					HAL_GPIO_WritePin(A2_GPIO_Port, A2_Pin, RESET);
					HAL_GPIO_WritePin(G2_GPIO_Port, G2_Pin, SET);
					HAL_Delay(500);
					HAL_GPIO_WritePin(R2_GPIO_Port, R2_Pin, RESET);
					HAL_GPIO_WritePin(A2_GPIO_Port, A2_Pin, SET);
					break;

				case RED_AMBER:
					manual_state = RED_GREEN;
					HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, SET);
					HAL_GPIO_WritePin(A1_GPIO_Port, A1_Pin, RESET);
					HAL_GPIO_WritePin(G1_GPIO_Port, G1_Pin, SET);
					HAL_GPIO_WritePin(R2_GPIO_Port, R2_Pin, SET);
					HAL_GPIO_WritePin(A2_GPIO_Port, A2_Pin, SET);
					HAL_GPIO_WritePin(G2_GPIO_Port, G2_Pin, RESET);
					HAL_Delay(500);
					HAL_GPIO_WritePin(R1_GPIO_Port, R1_Pin, RESET);
					HAL_GPIO_WritePin(A1_GPIO_Port, A1_Pin, SET);
					break;
				}
		    }

		if (isButtonPressed(2) == 1) {
			status = MODE1;
		}
	default:
		break;

	}
}

