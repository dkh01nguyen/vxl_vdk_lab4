#include "fsm_traffic_light.h"

int mode = INIT;
void fsm() {
	switch (mode) {
		case INIT:
			mode = AUTO;
			status = INIT;
		case AUTO:
			fsm_auto();
		case CONFIG:
			fsm_config();
		case FMANUAL:
			fsm_manual();
		default:
			break;
	}
}

